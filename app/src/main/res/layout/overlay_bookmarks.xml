<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayBookmarksRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_white"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏：标题居中，「完成」贴在右端、保持蓝色 -->
        <FrameLayout
            android:id="@+id/bmTopBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ios_bar_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/bookmarks_title"
                android:textColor="@android:color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBmDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/done"
                android:textColor="@color/ios_blue"
                android:textSize="16sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bmSegment"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/segBookmarks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/seg_bookmarks"
                android:textColor="@color/ios_blue"
                android:textSize="13sp" />

            <Button
                android:id="@+id/segReading"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/seg_reading"
                android:textColor="@color/ios_blue"
                android:textSize="13sp" />

            <Button
                android:id="@+id/segHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/seg_history"
                android:textColor="@color/ios_blue"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 三张列表（书签 / 阅读列表 / 历史记录）都塞进这个容器，切换分段只改可见性 -->
        <FrameLayout
            android:id="@+id/bmListHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/ios_bar_bg"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnBmEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:textColor="@color/ios_blue"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
